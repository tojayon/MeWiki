{
  "name": "mewiki",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite preview --host 127.0.0.1 --port 5280 --strictPort",
    "dev": "vite --host 127.0.0.1 --port 5280 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 5280 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run i18n:check && npm run lint && npm test && npm run build",
    "i18n:check": "node scripts/check-i18n.mjs",
    "docs:screenshots": "node scripts/capture-gallery.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@noble/hashes": "^2.4.0",
    "@xyflow/react": "^12.12.1",
    "@zip.js/zip.js": "^2.24.0",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.58.0",
    "mermaid": "^12.3.0",
    "parse5": "^8.1.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.14",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "description": "本地优先的 Wiki 文档编辑与知识管理工具",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tojayon/MeWiki.git"
  },
  "homepage": "https://github.com/tojayon/MeWiki#readme",
  "bugs": {
    "url": "https://github.com/tojayon/MeWiki/issues"
  }
}
